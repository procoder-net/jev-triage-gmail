{
  "manifest_version": 3,
  "name": "Jev Triage for Gmail",
  "version": "3.2.0",
  "description": "Works inside your open Gmail tab: reads each email, asks Jev (TypeSafe AI) what it is, and applies Gmail labels one by one.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Jev Triage" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["taxonomy.js", "gmail-ui.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
